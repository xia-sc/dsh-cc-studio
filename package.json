{
  "name": "@xia-sc/dsh-cc-studio",
  "version": "0.8.3",
  "description": "CCv3 角色卡工坊：融合工坊 + CC 模式 + JSON/PNG/CHARX + 中英双语（跟随全局）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "character-card",
    "ccv3",
    "charx",
    "sillytavern",
    "worldbook"
  ],
  "homepage": "https://github.com/xia-sc/dsh-cc-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xia-sc/dsh-cc-studio.git"
  },
  "bugs": {
    "url": "https://github.com/xia-sc/dsh-cc-studio/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./agent": "./lib/agent.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "presets"
  ],
  "scripts": {
    "test": "node tests/rpc-channel.test.mjs && node tests/preset-install.test.mjs && node tests/cc-detection.test.mjs && node tests/client-greetings.test.mjs && node tests/draft-slot-sync.test.mjs && node tests/nav-highlight.test.mjs && node tests/clear-card.test.mjs && node tests/export-entry.test.mjs && node tests/close-button.test.mjs && node tests/tools-contract.test.mjs && node tests/relations.test.mjs && node tests/relations-view.test.mjs && node tests/shared-book.test.mjs && node tests/data-root.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/cc.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1",
      "dshReleases": {
        "0.1.5-rc.1": "compatible",
        "0.1.5-rc.2": "compatible",
        "0.1.6-alpha.1": "compatible",
        "0.1.6-alpha.2": "compatible",
        "0.1.7-alpha.1": "compatible",
        "0.1.7-rc.1": "compatible",
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
